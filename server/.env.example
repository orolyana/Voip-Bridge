# Browser-facing Node.js server port.
PORT=3000
# Set to production on the VPS; development is useful for local testing.
NODE_ENV=development
# Bind address. Keep 0.0.0.0 when using a reverse proxy or direct VPS access.
WEB_HOST=0.0.0.0

# Asterisk SIP domain and browser WebSocket endpoint.
SIP_DOMAIN=your-asterisk-domain.example
SIP_WS_URL=wss://your-asterisk-domain.example:8089/ws
SIP_USERNAME=webuser
SIP_PASSWORD=replace-with-real-sip-password

# Absolute paths or paths relative to server/ for the Node.js HTTPS server.
# Leave these unset only for local HTTP testing on localhost.
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt

# Optional ICE servers for browser media. Use a comma-separated list when
# more than one URL is required. TURN is recommended for restrictive NATs.
STUN_SERVER_URLS=stun:stun.l.google.com:19302
TURN_SERVER_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_USERNAME=replace-with-turn-username
TURN_PASSWORD=replace-with-turn-password
