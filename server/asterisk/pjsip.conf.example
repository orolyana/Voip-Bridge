; Asterisk PJSIP/WebRTC configuration for the browser and Android gateway.
; Copy the relevant sections into /etc/asterisk/pjsip.conf and replace secrets.

[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

[web-auth]
type=auth
auth_type=userpass
username=webuser
password=replace-web-password

[web-aor]
type=aor
max_contacts=1
remove_existing=yes

[web-endpoint]
type=endpoint
aors=web-aor
auth=web-auth
context=from-web
transport=transport-wss
webrtc=yes
disallow=all
allow=opus,ulaw,alaw,g722
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
ice_support=yes
media_encryption=dtls

[gateway-auth]
type=auth
auth_type=userpass
username=gateway
password=replace-gateway-password

[gateway-aor]
type=aor
max_contacts=1
remove_existing=yes

[gateway-endpoint]
type=endpoint
aors=gateway-aor
auth=gateway-auth
context=from-gateway
transport=transport-udp
disallow=all
allow=g722,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[gateway-identify]
type=identify
endpoint=gateway-endpoint
match=0.0.0.0/0
