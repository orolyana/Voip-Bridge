[general]
context=public
allowguest=no
udpbindaddr=0.0.0.0
tcpenable=yes
transport=ws,wss,udp,tcp
srvlookup=yes

[webrtc](!)
type=friend
auth=webrtc-auth
context=from-web
transport=ws,wss,tls,udp,tcp
encryption=yes
avpf=yes
force_avp=yes
icesupport=yes
rtcp_mux=yes
dtlsenable=yes
dtls_cert_file=/etc/asterisk/keys/asterisk.pem
dtls_private_key=/etc/asterisk/keys/asterisk.key
dtls_verify=fingerprint
dtls_setup=actpass

[web-user](webrtc)
secret=change-me
username=webuser
host=dynamic
qualify=yes
nat=yes

[web-gateway](webrtc)
secret=change-me
username=gateway
host=dynamic
qualify=yes
nat=yes

[webrtc-auth]
; Asterisk uses auth in a separate section if you configure it this way.

[authentication]
; Optional: use usermap or external auth store if desired.
